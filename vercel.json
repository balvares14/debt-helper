{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "express",
      "entrypoint": "server.js"
    },
    "client": {
      "root": "client",
      "framework": "vite",
      "outputDirectory": "build",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "app" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "client" }
    }
  ]
}
